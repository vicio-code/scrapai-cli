{
  "name": "careers_hugoboss_com",
  "source_url": "https://careers.hugoboss.com/global/en",
  "allowed_domains": ["careers.hugoboss.com"],
  "start_urls": [
    "https://careers.hugoboss.com/global/en/job/142749/Part-Time-Sales-Associate-BOSS-Outlet-Charlotte",
    "https://careers.hugoboss.com/global/en/job/142750/Full-Time-Sales-Associate-Macy-s-Shop-Lenox-Square",
    "https://careers.hugoboss.com/global/en/job/142751/Part-Time-Sales-Associate-BOSS-Store-Charlotte",
    "https://careers.hugoboss.com/global/en/job/142752/Part-Time-Sales-Associate-BOSS-Store-Arlington-Pentagon-City",
    "https://careers.hugoboss.com/global/en/job/142759/Full-Time-Stock-Associate-BOSS-Outlet-Leesburg"
  ],
  "sections": [
    {
      "match": ["/global/en/job/.*"],
      "follow": false,
      "extract": {
        "title": {"css": "h1.job-title::text"},
        "description": {
          "css": "[data-ph-at-id='jobdescription-text'] *::text",
          "get_all": true,
          "processors": [
            {"type": "strip"},
            {"type": "join", "separator": " "}
          ]
        },
        "employer": {
          "css": "meta[name='x-employer']::attr(content)",
          "processors": [{"type": "default", "default": "Hugo Boss"}]
        },
        "location": {
          "css": "[data-ph-at-id='job-info'][data-ph-at-job-title-text]::attr(data-ph-at-job-location-text)"
        },
        "job_id": {
          "css": "[data-ph-at-id='job-info'][data-ph-at-job-title-text]::attr(data-ph-at-job-id-text)"
        },
        "hints_job_function": {
          "css": "[data-ph-at-id='job-info'][data-ph-at-job-title-text]::attr(data-ph-at-job-category-text)"
        },
        "hints_position_type": {
          "css": "span.hiringType::text",
          "processors": [{"type": "strip"}]
        }
      }
    }
  ],
  "settings": {
    "CLOUDFLARE_ENABLED": true,
    "CLOUDFLARE_STRATEGY": "browser_only",
    "CF_WAIT_SELECTOR": "h1.job-title",
    "CLOUDFLARE_COOKIE_REFRESH_THRESHOLD": 0,
    "DOWNLOAD_DELAY": 1,
    "CONCURRENT_REQUESTS": 1,
    "CONCURRENT_REQUESTS_PER_DOMAIN": 1,
    "AUTOTHROTTLE_ENABLED": false
  }
}
