{
  "name": "careers_hugoboss_com",
  "source_url": "https://careers.hugoboss.com/global/en",
  "allowed_domains": ["careers.hugoboss.com"],
  "start_urls": [
    "https://careers.hugoboss.com/global/en/search-results"
  ],
  "sections": [
    {
      "match": ["/global/en/job/.*"],
      "extract": {
        "title": {"css": "h1.job-title::text"},
        "description": {
          "css": "[data-ph-at-id='jobdescription-text'] *::text",
          "get_all": true,
          "processors": [
            {"type": "strip"},
            {"type": "join", "separator": " "}
          ]
        },
        "employer": {
          "css": "address.phw-mt-3 p:first-child::text",
          "processors": [
            {"type": "strip"},
            {"type": "default", "default": "Hugo Boss"}
          ]
        },
        "location": {
          "css": "[data-ph-at-id='job-info'][data-ph-at-job-title-text]::attr(data-ph-at-job-location-text)"
        },
        "job_id": {
          "css": "[data-ph-at-id='job-info'][data-ph-at-job-title-text]::attr(data-ph-at-job-id-text)"
        },
        "hints_job_function": {
          "css": "[data-ph-at-id='job-info'][data-ph-at-job-title-text]::attr(data-ph-at-job-category-text)"
        },
        "hints_position_type": {
          "css": "span.hiringType i::attr(class)",
          "processors": [
            {"type": "regex", "pattern": "icon-([a-z][a-z-]+)"},
            {"type": "replace", "old": "-", "new": " "}
          ]
        }
      }
    },
    {
      "match": ["/global/en/search-results.*"],
      "follow": true
    },
    {
      "match": [".*"],
      "follow": true
    }
  ],
  "settings": {
    "BROWSER_ENABLED": true,
    "CLOUDFLARE_STRATEGY": "browser_only",
    "CF_WAIT_SELECTOR": "h1.job-title",
    "EXTRACTOR_ORDER": ["custom"],
    "DOWNLOAD_DELAY": 1,
    "CONCURRENT_REQUESTS": 1,
    "CONCURRENT_REQUESTS_PER_DOMAIN": 1,
    "AUTOTHROTTLE_ENABLED": false,
    "DELTAFETCH_ENABLED": false
  }
}
