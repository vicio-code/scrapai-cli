{
  "name": "vfc_wd5_myworkdayjobs_com",
  "source_url": "https://vfc.wd5.myworkdayjobs.com/vfc_careers",
  "allowed_domains": ["vfc.wd5.myworkdayjobs.com"],
  "start_urls": [
    "https://vfc.wd5.myworkdayjobs.com/en-US/vfc_careers/job/USCA--USA--California--Costa-Mesa-HQ---VAN/Senior-Retail-Operations-Finance-Analyst_R-20260515-0035-1",
    "https://vfc.wd5.myworkdayjobs.com/en-US/vfc_careers/job/USCA--USA--California--Costa-Mesa-HQ---VAN/Vans--Designer--Women-s-Apparel_R-20260713-0040-1",
    "https://vfc.wd5.myworkdayjobs.com/en-US/vfc_careers/job/USCA--USA--California--Remote/Vans--Senior-Strategic-Account-Manager_R-20260720-0022-1",
    "https://vfc.wd5.myworkdayjobs.com/en-US/vfc_careers/job/USCA--USA--Colorado--Denver-HQ---VFC/Altra--Senior-Footwear-Designer_R-20260126-0043-1",
    "https://vfc.wd5.myworkdayjobs.com/en-US/vfc_careers/job/EMEA--BEL--Antwerp---VF-Europe-Link-1/Analyst--Sales-Operations--EMEA-_R-20260615-0021-3"
  ],
  "sections": [
    {
      "match": [".*/vfc_careers/job/.*"],
      "deny": ["/apply"],
      "follow": false,
      "extract": {
        "title": {"css": "h2[data-automation-id='jobPostingHeader']::text"},
        "description": {
          "css": "div[data-automation-id='jobPostingDescription']",
          "to_text": true
        },
        "employer": {
          "css": "div[data-automation-id='jobPostingDescription'] p:contains('Careers')",
          "to_text": true,
          "processors": [
            {"type": "regex", "pattern": "visit ([A-Za-z &]+) Careers"},
            {"type": "strip"},
            {"type": "replace", "old": "VF", "new": "VF Corporation"},
            {"type": "default", "default": "VF Corporation"}
          ]
        },
        "location": {"css": "div[data-automation-id='locations'] dd::text"},
        "job_id": {"css": "div[data-automation-id='requisitionId'] dd::text"},
        "hints_position_type": {"css": "div[data-automation-id='time'] dd::text"},
        "published_date": {
          "css": "div[data-automation-id='postedOn'] dd::text",
          "processors": [
            {"type": "regex", "pattern": "Posted (.+)"},
            {"type": "strip"},
            {"type": "parse_datetime"}
          ]
        }
      }
    }
  ],
  "settings": {
    "BROWSER_ENABLED": true,
    "CLOUDFLARE_STRATEGY": "browser_only",
    "CF_WAIT_SELECTOR": "h2[data-automation-id='jobPostingHeader']",
    "CONCURRENT_REQUESTS": 1,
    "CONCURRENT_REQUESTS_PER_DOMAIN": 1,
    "AUTOTHROTTLE_ENABLED": false,
    "DELTAFETCH_ENABLED": false
  }
}
