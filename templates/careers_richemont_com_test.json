{
  "name": "careers_richemont_com",
  "source_url": "https://careers.richemont.com/en/jobs/",
  "allowed_domains": ["careers.richemont.com"],
  "start_urls": [
    "https://careers.richemont.com/en/jobs/jr132554/senior-client-advisor/",
    "https://careers.richemont.com/en/jobs/jr132503/sales-associate-palo-alto/",
    "https://careers.richemont.com/en/jobs/jr131873/head-of-experiences-meiat/",
    "https://careers.richemont.com/en/jobs/jr132517/sales-advisor/",
    "https://careers.richemont.com/en/jobs/jr132505/sales-associate-san-diego/"
  ],
  "settings": {
    "CURL_CFFI_ENABLED": true
  },
  "sections": [
    {
      "match": ["/en/jobs/jr[^/]+/[^/]+/"],
      "follow": false,
      "extract": {
        "title": {
          "css": "section.hero h1::text",
          "processors": [{"type": "strip"}]
        },
        "description": {
          "css": "article.cms-content",
          "to_text": true
        },
        "employer": {
          "css": ".breadcrumb-wrap .breadcrumb li:nth-child(2) span::text",
          "processors": [{"type": "strip"}]
        },
        "location": {
          "css": "section.hero ul.list-inline.job-meta li:nth-child(2)::text",
          "get_all": true,
          "processors": [
            {"type": "join", "separator": ""},
            {"type": "strip"}
          ]
        },
        "job_id": {
          "css": "h2.h5::text",
          "processors": [
            {"type": "regex", "pattern": "(JR[\\w]+)"},
            {"type": "strip"}
          ]
        },
        "hints_position_type": {
          "css": "section.hero ul.list-inline.job-meta li:last-child::text",
          "processors": [{"type": "strip"}]
        },
        "hints_job_function": {
          "css": "section.hero ul.list-inline.job-meta li:nth-child(1)::text",
          "get_all": true,
          "processors": [
            {"type": "join", "separator": ""},
            {"type": "strip"}
          ]
        }
      }
    }
  ]
}
