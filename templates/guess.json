{
  "name": "guess",
  "source_url": "https://apply.workable.com/guess-europe-sagl/",
  "allowed_domains": [
    "apply.workable.com"
  ],
  "start_urls": [],
  "sections": [
    {
      "match": [
        "/guess-europe-sagl/jobs/view/[A-Z0-9]+[.]md"
      ],
      "follow": false,
      "extract": {
        "title": {
          "css": "body::text",
          "processors": [
            {
              "type": "regex",
              "pattern": "# (.+)"
            }
          ]
        },
        "description": {
          "css": "body::text",
          "processors": [
            {
              "type": "regex",
              "pattern": "## Description\n\n([\\s\\S]+)"
            }
          ]
        },
        "employer": {
          "css": "body::text",
          "processors": [
            {
              "type": "regex",
              "pattern": "[*][*]Department:[*][*] (.+)"
            },
            {"type": "replace", "old": "Retail", "new": "Guess"},
            {
              "type": "default",
              "default": "Guess"
            }
          ]
        },
        "location": {
          "css": "body::text",
          "processors": [
            {
              "type": "regex",
              "pattern": "> Guess Europe Sagl [\u00b7] (.+?) [\u00b7]"
            },
            {
              "type": "strip"
            }
          ]
        },
        "job_id": {
          "css": "body::text",
          "processors": [
            {
              "type": "regex",
              "pattern": "/j/([A-Z0-9]+)/apply"
            }
          ]
        },
        "published_date": {
          "css": "body::text",
          "processors": [
            {
              "type": "regex",
              "pattern": "Posted (\\d{4}-\\d{2}-\\d{2})"
            },
            {
              "type": "parse_datetime"
            }
          ]
        },
        "hints_position_type": {
          "css": "body::text",
          "processors": [
            {
              "type": "regex",
              "pattern": "> Guess Europe Sagl [\u00b7] .+? [\u00b7] (.+?) [\u00b7] Posted"
            },
            {"type": "replace", "old": "\u2014", "new": ""},
            {"type": "default", "default": null}
          ]
        },
        "hints_workplace_type": {
          "css": "body::text",
          "processors": [
            {
              "type": "regex",
              "pattern": "[*][*]Workplace:[*][*] (.+)"
            }
          ]
        }
      }
    }
  ],
  "settings": {
    "EXTRACTOR_ORDER": [
      "custom"
    ],
    "DOWNLOAD_DELAY": 0.5,
    "CONCURRENT_REQUESTS": 8,
    "AUTOTHROTTLE_ENABLED": true,
    "DELTAFETCH_ENABLED": false,
