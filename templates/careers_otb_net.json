{
  "name": "careers_otb_net",
  "source_url": "https://careers.otb.net",
  "allowed_domains": ["careers.otb.net"],
  "start_urls": ["https://careers.otb.net/sitemap.xml"],
  "sections": [
    {
      "match": ["/job/[^/]+/\\d+/"],
      "follow": false,
      "extract": {
        "title": {
          "css": "span[data-careersite-propertyid='title']::text",
          "processors": [{"type": "strip"}]
        },
        "description": {
          "css": "span[data-careersite-propertyid='description'] span.jobdescription",
          "to_text": true
        },
        "employer": {
          "css": "span[data-careersite-propertyid='dept']::text",
          "processors": [{"type": "strip"}]
        },
        "location": {
          "css": "span.jobGeoLocation::text",
          "processors": [{"type": "strip"}]
        },
        "job_id": {
          "css": "a[href*='/talentcommunity/apply/']::attr(href)",
          "processors": [{"type": "regex", "pattern": "apply/(\\d+)/"}]
        },
        "published_date": {
          "css": "span[data-careersite-propertyid='date']::text",
          "processors": [{"type": "strip"}, {"type": "parse_datetime"}]
        },
        "hints_position_type": {
          "css": "span[data-careersite-propertyid='customfield3']::text",
          "processors": [{"type": "strip"}]
        },
        "hints_job_function": {
          "css": "span[data-careersite-propertyid='department']::text",
          "processors": [{"type": "strip"}]
        }
      }
    }
  ],
  "settings": {
    "EXTRACTOR_ORDER": ["custom"],
    "USE_SITEMAP": true,
    "DOWNLOAD_DELAY": 1,
    "CONCURRENT_REQUESTS": 8,
    "AUTOTHROTTLE_ENABLED": true,
    "DELTAFETCH_ENABLED": false
  }
}
