{
  "name": "christies_wd3_myworkdayjobs_com",
  "source_url": "https://christies.wd3.myworkdayjobs.com/it-IT/Christies_Careers",
  "allowed_domains": ["christies.wd3.myworkdayjobs.com"],
  "start_urls": [
    "https://christies.wd3.myworkdayjobs.com/en-US/Christies_Careers/job/London/Account-Manager--EAV--6-month-FTC-_JR00014935",
    "https://christies.wd3.myworkdayjobs.com/en-US/Christies_Careers/job/New-York/Proposals-Writer--Temporary-_JR00014936",
    "https://christies.wd3.myworkdayjobs.com/en-US/Christies_Careers/job/New-York/Bids---Client-Services-Supervisor--Operations_JR00014874",
    "https://christies.wd3.myworkdayjobs.com/en-US/Christies_Careers/job/Paris/Specialist--Jewellery_JR00014942",
    "https://christies.wd3.myworkdayjobs.com/en-US/Christies_Careers/job/Works-from-Home-United-Kingdom/Enterprise-Integration-Tech-Lead_JR00014406"
  ],
  "sections": [
    {
      "match": [".*/Christies_Careers/job/[^/]+/[^/]+$"],
      "follow": false,
      "extract": {
        "title": {"css": "title::text"},
        "description": {
          "css": "div[data-automation-id='jobPostingDescription']",
          "to_text": true
        },
        "employer": {
          "css": "h1::text",
          "processors": [{"type": "regex", "pattern": "(Christie's)"}]
        },
        "location": {
          "xpath": "//dt[normalize-space(text())='locations']/following-sibling::dd[1]//text()"
        },
        "job_id": {
          "xpath": "//dt[contains(text(),'job requisition')]/following-sibling::dd[1]//text()"
        },
        "hints_position_type": {
          "xpath": "//dt[normalize-space(text())='time type']/following-sibling::dd[1]//text()"
        },
        "published_date": {
          "xpath": "//dt[normalize-space(text())='posted on']/following-sibling::dd[1]//text()",
          "processors": [
            {"type": "regex", "pattern": "Posted (.+)"},
            {"type": "parse_datetime"}
          ]
        }
      }
    }
  ],
  "settings": {
    "BROWSER_ENABLED": true,
    "CLOUDFLARE_STRATEGY": "browser_only",
    "CF_WAIT_SELECTOR": "div[data-automation-id='jobPostingDescription']",
    "CF_WAIT_TIMEOUT": 20,
    "EXTRACTOR_ORDER": ["custom"],
    "CONCURRENT_REQUESTS": 1,
    "CONCURRENT_REQUESTS_PER_DOMAIN": 1,
    "AUTOTHROTTLE_ENABLED": false
  }
}
