{
  "name": "boards_greenhouse_io_sothebys",
  "source_url": "https://boards.greenhouse.io/sothebys",
  "allowed_domains": ["boards.greenhouse.io", "job-boards.greenhouse.io"],
  "start_urls": [
    "https://job-boards.greenhouse.io/sothebys/jobs/4919934004",
    "https://job-boards.greenhouse.io/sothebys/jobs/5836255004",
    "https://job-boards.greenhouse.io/sothebys/jobs/6126742004",
    "https://job-boards.greenhouse.io/sothebys/jobs/6133657004",
    "https://job-boards.greenhouse.io/sothebys/jobs/6107115004"
  ],
  "sections": [
    {
      "match": ["/sothebys/jobs/\\d+"],
      "follow": false,
      "extract": {
        "title": {
          "css": "div.job__title h1::text",
          "processors": [{"type": "strip"}]
        },
        "description": {
          "css": "div.job__description",
          "to_text": true
        },
        "location": {
          "css": "div.job__location *::text",
          "processors": [{"type": "strip"}]
        },
        "employer": {
          "css": "title::text",
          "processors": [
            {"type": "regex", "pattern": " at (.+)$"},
            {"type": "default", "default": "Sotheby's"},
            {"type": "strip"}
          ]
        },
        "job_id": {
          "css": "form#application-form::attr(action)",
          "processors": [
            {"type": "regex", "pattern": "(\\d+)$"}
          ]
        }
      }
    }
  ],
  "settings": {
    "EXTRACTOR_ORDER": ["custom"],
    "DOWNLOAD_DELAY": 0,
    "CONCURRENT_REQUESTS": 32,
    "CONCURRENT_REQUESTS_PER_DOMAIN": 16,
    "AUTOTHROTTLE_ENABLED": false
  }
}
