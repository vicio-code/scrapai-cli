{
  "name": "kering_com",
  "source_url": "https://www.kering.com/en/talent/job-offers",
  "allowed_domains": ["www.kering.com"],
  "start_urls": [],
  "rules": [],
  "callbacks": {
    "parse_listing": {
      "iterate": {
        "selector": "div.t10m8cnn",
        "follow": {
          "url": {"css": "h2 a::attr(href)"},
          "callback": "parse_job"
        }
      },
      "extract": {
        "hints_job_function": {
          "xpath": "div[2]//p/text()[2]",
          "processors": [{"type": "strip"}]
        }
      }
    },
    "parse_job": {
      "extract": {
        "title": {
          "css": "h1::text",
          "processors": [{"type": "strip"}]
        },
        "description": {
          "css": "h1 ~ div",
          "to_text": true
        },
        "employer": {
          "css": "h2 span:nth-child(1)::text",
          "processors": [{"type": "strip"}]
        },
        "location": {
          "css": "h2 span:nth-of-type(3)::text, h2 span:nth-of-type(4)::text",
          "get_all": true,
          "processors": [{"type": "join", "separator": " - "}]
        },
        "job_id": {
          "css": "a[href^='https://careers.kering.com/careers']::attr(href)",
          "processors": [{"type": "regex", "pattern": "careers/([A-Z][0-9]+)"}]
        },
        "published_date": {
          "css": "p.t1ahz3a9::text",
          "processors": [{"type": "parse_datetime"}]
        },
        "hints_position_type": {
          "css": "div#job-footer ul li:nth-child(1)::text",
          "processors": [{"type": "strip"}]
        },
        "hints_workplace_type": {
          "css": "meta[name='workplace-type']::attr(content)",
          "processors": [{"type": "default", "default": null}]
        },
        "hints_compensation": {
          "css": "meta[name='compensation']::attr(content)",
          "processors": [{"type": "default", "default": null}]
        }
      }
    }
  },
  "settings": {
    "EXTRACTOR_ORDER": ["custom"],
    "DOWNLOAD_DELAY": 0,
    "CONCURRENT_REQUESTS": 32,
    "CONCURRENT_REQUESTS_PER_DOMAIN": 16,
    "AUTOTHROTTLE_ENABLED": false,
    "GENERATED_URLS": [
      {
        "template": "https://www.kering.com/en/talent/job-offers/?page={page}",
        "vars": {
          "page": {"type": "range", "from": 1, "to": 116}
        },
        "callback": "parse_listing"
      }
    ]
  }
}
