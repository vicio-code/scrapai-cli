{
  "name": "sec_wd3_myworkdayjobs_com",
  "source_url": "https://sec.wd3.myworkdayjobs.com/pt-BR/Samsung_Careers",
  "allowed_domains": ["sec.wd3.myworkdayjobs.com"],
  "start_urls": [
    "https://sec.wd3.myworkdayjobs.com/pt-BR/Samsung_Careers/job/6625-Excellence-Way-Plano-TX-USA/Manager--Digital-Marketing---com--Plano--TX-_R119239",
    "https://sec.wd3.myworkdayjobs.com/pt-BR/Samsung_Careers/job/Samsung-ESBO-Floor-3-Eighty-Strand-London-WC2R-0RE/Senior-Legal-Counsel---Commercial_R119378",
    "https://sec.wd3.myworkdayjobs.com/pt-BR/Samsung_Careers/job/6-rue-Fructidor-Saint-Ouen-France/Chef-de-Projet-Junior-Trade-Marketing---Division-Telecom--Saint-Ouen--93--H-F----Stage_R118610",
    "https://sec.wd3.myworkdayjobs.com/pt-BR/Samsung_Careers/job/12100-Samsung-Blvd-Austin-TX-USA/Talent-Development-Facilitator_R117856",
    "https://sec.wd3.myworkdayjobs.com/pt-BR/Samsung_Careers/job/645-Clyde-Avenue-Mountain-View-CA-USA/Procurement-Specialist--Bilingual-Spanish_R119210-1"
  ],
  "sections": [
    {
      "match": ["/Samsung_Careers/job/"],
      "deny": ["/apply"],
      "follow": false,
      "extract": {
        "title": {
          "css": "h2[data-automation-id='jobPostingHeader']::text",
          "processors": [{"type": "strip"}]
        },
        "description": {
          "css": "[data-automation-id='jobPostingDescription']",
          "to_text": true
        },
        "employer": {
          "css": "meta[property='og:description']::attr(content)",
          "processors": [
            {"type": "regex", "pattern": "(Samsung Electronics)"},
            {"type": "default", "default": "Samsung Electronics"}
          ]
        },
        "location": {
          "css": "[data-automation-id='locations'] dd::text",
          "processors": [{"type": "strip"}]
        },
        "job_id": {
          "css": "[data-automation-id='requisitionId'] dd::text",
          "processors": [{"type": "strip"}]
        },
        "hints_position_type": {
          "css": "[data-automation-id='time'] dd::text",
          "processors": [{"type": "strip"}]
        },
        "hints_workplace_type": {
          "css": "[data-automation-id='remoteType'] dd::text",
          "processors": [{"type": "strip"}]
        },
        "published_date": {
          "xpath": "//dt[normalize-space(text())='posted on']/following-sibling::dd[1]//text()",
          "processors": [
            {"type": "regex", "pattern": "(?:Posted|Publicado) (.+)"},
            {"type": "parse_datetime"}
          ]
        }
      }
    }
  ],
  "settings": {
    "BROWSER_ENABLED": true,
    "CLOUDFLARE_STRATEGY": "browser_only",
    "CF_WAIT_SELECTOR": "[data-automation-id='jobPostingDescription']",
    "CF_WAIT_TIMEOUT": 20,
    "EXTRACTOR_ORDER": ["custom"],
    "DOWNLOAD_DELAY": 1,
    "CONCURRENT_REQUESTS": 1,
    "AUTOTHROTTLE_ENABLED": false,
    "DELTAFETCH_ENABLED": false
  }
}
