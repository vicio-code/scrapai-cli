{
  "name": "www_lvmh_com",
  "source_url": "https://www.lvmh.com/en/join-us/our-job-offers",
  "allowed_domains": ["www.lvmh.com"],
  "start_urls": [],
  "sections": [
    {
      "match": ["/en/join-us/our-job-offers/[0-9]+"],
      "follow": false,
      "extract": {
        "title": {
          "css": "h1[id^='offerTitle-']::text"
        },
        "description": {
          "css": "div.richText",
          "to_text": true
        },
        "employer": {
          "css": "h1[id^='offerTitle-'] ~ p.typo-subtitle:first-of-type::text"
        },
        "location": {
          "css": "li.hidden.items-center.justify-center.gap-2.sm\\:flex *::text"
        },
        "job_id": {
          "css": "h1[id^='offerTitle-']::attr(id)",
          "processors": [
            {"type": "regex", "pattern": "offerTitle-(.+)"}
          ]
        },
        "published_date": {
          "css": "p.typo-body-s.uppercase.text-thematique-greyBlue::text",
          "processors": [
            {"type": "regex", "pattern": "Published on (.+)"},
            {"type": "parse_datetime", "format": "%m.%d.%Y"}
          ]
        },
        "hints_position_type": {
          "css": "ul.typo-body-s.hidden.flex-nowrap li:nth-child(4) *::text",
          "processors": [{"type": "strip"}]
        },
        "hints_workplace_type": {
          "css": "ul.typo-body-s.hidden.flex-nowrap li:nth-child(5) *::text",
          "processors": [{"type": "strip"}, {"type": "default", "default": null}]
        },
        "hints_compensation": {
          "css": "ul.typo-body-s.hidden.flex-nowrap li:nth-child(6) *::text",
          "processors": [{"type": "strip"}, {"type": "default", "default": null}]
        },
        "hints_job_function": {
          "css": "h1[id^='offerTitle-'] ~ p.typo-subtitle:nth-of-type(2)::text"
        }
      }
    },
    {
      "match": ["/en/join-us/.*"],
      "follow": true
    }
  ],
  "settings": {
    "BROWSER_ENABLED": true,
    "DOWNLOAD_DELAY": 1,
    "CONCURRENT_REQUESTS": 4,
    "CONCURRENT_REQUESTS_PER_DOMAIN": 2,
    "AUTOTHROTTLE_ENABLED": false,
    "GENERATED_URLS": [
      {
        "template": "https://www.lvmh.com/en/join-us/our-job-offers?PRD-en-us-timestamp-desc%5Bpage%5D={page}",
        "vars": {
          "page": {"type": "range", "from": 1, "to": 502}
        },
        "follow": true
      }
    ]
  }
}
